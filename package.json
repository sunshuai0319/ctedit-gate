{
  "name": "credit-gate-primus-demo",
  "private": true,
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "test": "vitest run",
    "typecheck": "tsc -b apps/server apps/web --pretty false",
    "build": "npm run build --workspace apps/web"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
