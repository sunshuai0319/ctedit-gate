# Server-only values
PRIMUS_APP_ID=your_primus_app_id
PRIMUS_APP_SECRET=server_only_secret
PRIMUS_TEMPLATE_ID=your_template_id
DEMO_CREDIT_SCORE=720
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
PUBLIC_SOURCE_URL=https://your-public-host.example/score

# Browser-safe values (copy to apps/web/.env.local, never put appSecret here)
VITE_PRIMUS_APP_ID=your_primus_app_id
VITE_PRIMUS_TEMPLATE_ID=your_template_id
VITE_RECIPIENT=0x0000000000000000000000000000000000000001
VITE_SIGNING_URL=http://localhost:8787/api/primus/sign
